---
import config from 'virtual:starlight/user-config'

import LanguageSelect from 'virtual:starlight/components/LanguageSelect'
import Search from 'virtual:starlight/components/Search'
import SocialIcons from 'virtual:starlight/components/SocialIcons'
import ThemeToggle from './ThemeToggle.astro'

const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro'
const pathname = Astro.url.pathname
const tabs = [
  { label: 'User docs', href: '/', active: pathname === '/' || pathname.startsWith('/getting-started/') },
  { label: 'Importing', href: '/import-sync/overview/', active: pathname.startsWith('/import-sync/') },
  { label: 'Recall cards', href: '/review-recall/how-review-works/', active: pathname.startsWith('/review-recall/') },
  {
    label: 'Privacy',
    href: '/account-data/privacy-beta-pricing/',
    active: pathname.includes('/privacy') || pathname.includes('/pricing'),
  },
  {
    label: 'Support',
    href: '/account-data/contact-support/',
    active: pathname.includes('/contact-support') || pathname.startsWith('/troubleshooting/'),
  },
]
---

<div class="docs-header-frame">
  <div class="header header-shell docs-header-top">
    <div class="title-wrapper sl-flex">
      <a href="/" class="docs-brand" aria-label="Acorny Docs home">
        <img src="/android-chrome-192x192.png" alt="Acorny logo" width="28" height="28" />
        <span class="docs-brand-name" translate="no">Acorny</span>
        <span class="docs-brand-divider" aria-hidden="true"></span>
        <span class="docs-brand-section">Docs</span>
      </a>
    </div>
    <div class="header-search sl-flex print:hidden">
      {shouldRenderSearch && <Search />}
    </div>
    <div class="sl-hidden md:sl-flex print:hidden right-group">
      <div class="sl-flex social-icons">
        <a href="https://acorny.io" class="download-link" rel="noopener noreferrer" target="_blank">Open Acorny</a>
        <SocialIcons />
      </div>
      <ThemeToggle />
      <LanguageSelect />
    </div>
  </div>
  <nav class="docs-section-tabs header-shell" aria-label="Documentation sections">
    {
      tabs.map((tab) => (
        <a
          href={tab.href}
          class:list={['docs-section-tab', { active: tab.active }]}
          aria-current={tab.active ? 'page' : undefined}
        >
          {tab.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  @layer starlight.core {
    .docs-header-frame {
      display: grid;
      grid-template-rows: 3.75rem 3rem;
      height: 100%;
    }

    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 3.75rem;
    }

    .title-wrapper {
      overflow: clip;
      min-width: 0;
      margin: -0.25rem;
      padding: 0.25rem;
    }

    .docs-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.64rem;
      min-width: 0;
      color: var(--ac-doc-text);
      font-size: 0.98rem;
      font-weight: 720;
      letter-spacing: -0.02em;
      text-decoration: none;
      white-space: nowrap;
    }

    .docs-brand img {
      flex: none;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 0.55rem;
      box-shadow: 0 10px 20px rgba(40, 24, 46, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.42);
    }

    .docs-brand-divider {
      width: 1px;
      height: 1.15rem;
      background: var(--sl-color-hairline);
    }

    .docs-brand-section {
      color: color-mix(in oklch, var(--ac-doc-text) 68%, var(--ac-doc-muted));
      font-weight: 560;
    }

    .header-search {
      flex: 1 1 28.75rem;
      max-width: 28.75rem;
    }

    .header-search :global(button[data-open-modal]) {
      max-width: none;
    }

    .docs-section-tabs {
      display: flex;
      align-items: end;
      gap: 2.15rem;
      height: 3rem;
      margin-inline: auto;
      border-bottom: 1px solid transparent;
    }

    .docs-section-tab {
      position: relative;
      display: inline-flex;
      align-items: center;
      height: 100%;
      color: color-mix(in oklch, var(--ac-doc-text) 58%, var(--ac-doc-muted));
      font-size: 0.9rem;
      font-weight: 650;
      letter-spacing: -0.01em;
      text-decoration: none;
    }

    .docs-section-tab.active {
      color: var(--ac-doc-text);
    }

    .docs-section-tab.active::after {
      content: "";
      position: absolute;
      inset-inline: -0.08rem;
      bottom: 0;
      height: 2px;
      border-radius: 999px 999px 0 0;
      background: var(--sl-color-accent);
      box-shadow: 0 -8px 24px color-mix(in oklch, var(--ac-doc-accent) 24%, transparent);
    }

    .right-group,
    .social-icons {
      align-items: center;
      gap: 1rem;
    }

    .social-icons::after {
      content: "";
      height: 2rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (max-width: 50rem) {
      .docs-header-frame {
        grid-template-rows: 3.6rem;
      }

      .header {
        height: 3.6rem;
      }

      .header-search {
        flex: 0 0 auto;
        margin-inline-start: auto;
        margin-inline-end: 3.25rem;
      }

      .docs-section-tabs {
        display: none;
      }
    }
  }
</style>
